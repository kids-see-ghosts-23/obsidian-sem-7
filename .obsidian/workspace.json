                    "bufferSerial": "Microsoft Windows [Version 10.0.26200.9974]\r\n(c) Microsoft Corporation. All rights reserved.\r\n\r\nC:\\Users\\karan\\OneDrive\\Desktop\\sem 7>opencode\r\nStarting background server...\u001b[1B\u001b[29D\u001b[?1049h\u001b[H\u001b[38;2;255;255;255;48;2;30;30;30m \u001b[38;2;157;124;216;1m•\u001b[38;2;255;255;255;22m \u001b[38;2;238;238;238;1mVRAR lab: 6 simple progra\u001b[38;2;196;196;196mm\u001b[38;2;146;146;146ms \u001b[38;2;47;47;47mw\u001b[38;2;128;128;128;48;2;10;10;10;22m +                                                                                  \u001b[38;2;255;255;255m     \u001b[38;2;250;178;131m- \u001b[38;2;238;238;238mProgram 1 uses one \u001b[38;2;127;216;143mUpdate() \u001b[38;2;238;238;238minstead of three helper methods.\u001b[47X\u001b[47C\u001b[38;2;136;136;136m  \r\n\u001b[38;2;255;255;255m     \u001b[38;2;250;178;131m- \u001b[38;2;238;238;238mProgram 2 uses legacy \u001b[38;2;127;216;143mText \u001b[38;2;238;238;238mto avoid the TMP import; the note explains the TextMeshPro swap.\u001b[16X\u001b[16C\u001b[38;2;136;136;136m  \r\n\u001b[38;2;255;255;255m     \u001b[38;2;250;178;131m- \u001b[38;2;238;238;238mProgram 5 uses free AR Foundation instead of Vuforia; the note mentions Vuforia as an alternative.\u001b[5X\u001b[5C  \u001b[38;2;136;136;136m \u001b[38;2;255;255;255m \u001b[38;2;136;136;136m  \r\n\u001b[38;2;255;255;255m     \u001b[38;2;250;178;131m- \u001b[38;2;238;238;238mProgram 5 needs an Android\u001b[38;2;127;216;143m \u001b[38;2;238;238;238mphone and AR Foundation; Program 6 needs a video and audio clip imported into   \u001b[38;2;136;136;136m  \r\n\u001b[38;2;255;255;255m       \u001b[38;2;238;238;238mUnity.\u001b[101X\u001b[101C\u001b[38;2;136;136;136m  \r\n\u001b[38;2;255;255;255m     \u001b[107X\u001b[107C\u001b[38;2;238;238;238m \u001b[38;2;255;255;255m \u001b[38;2;136;136;136m  \r\n\u001b[38;2;255;255;255m     \u001b[38;2;238;238;238mI also verified that every code block in the notes exactly matches its \u001b[38;2;127;216;143m.cs \u001b[38;2;238;238;238mfile, and that all braces/\u001b[7X\u001b[7C\u001b[38;2;255;255;255m \u001b[38;2;136;136;136m  \r\n\u001b[38;2;255;255;255m     \u001b[38;2;238;238;238mparentheses are balanced.\u001b[84X\u001b[84C\u001b[38;2;136;136;136m  \r\n\u001b[38;2;255;255;255m     \u001b[107X\u001b[107C\u001b[38;2;238;238;238m \u001b[38;2;255;255;255m \u001b[38;2;136;136;136m  \r\n\u001b[38;2;255;255;255m     \u001b[38;2;92;156;245mBuild \u001b[38;2;128;128;128m· DeepSeek V4.1 Flash Free · 8m 39s · 90.0 tok/s\u001b[54X\u001b[54C\u001b[38;2;255;255;255m \u001b[38;2;136;136;136m  \r\n\u001b[38;2;255;255;255m     \u001b[109X\u001b[109C\u001b[38;2;136;136;136m  \r\n\u001b[38;2;255;255;255m  \u001b[38;2;92;156;245;48;2;20;20;20m┃\u001b[111X\u001b[111C\u001b[38;2;136;136;136;48;2;10;10;10m  \r\n\u001b[38;2;255;255;255m  \u001b[38;2;92;156;245;48;2;20;20;20m┃  \u001b[38;2;238;238;238mok what are the 3 easiest programs to read rn\u001b[64X\u001b[64C\u001b[38;2;136;136;136;48;2;10;10;10m  \r\n\u001b[38;2;255;255;255m  \u001b[38;2;92;156;245;48;2;20;20;20m┃\u001b[111X\u001b[111C\u001b[38;2;255;255;255;48;2;10;10;10m  \r\n  \u001b[112X\u001b[112C\u001b[38;2;238;238;238m  \r\n\u001b[38;2;255;255;255m     \u001b[38;2;151;104;44m+ Thought · 12.8s\u001b[92X\u001b[92C\u001b[38;2;238;238;238m  \r\n\u001b[38;2;255;255;255m  \u001b[112X\u001b[112C  \r\n  \u001b[3X\u001b[3C\u001b[38;2;238;238;238mEasiest three to read right now, in this order:\u001b[62X\u001b[62C  \r\n\u001b[38;2;255;255;255m      \u001b[38;2;151;104;44m \u001b[38;2;255;255;255m       \u001b[100X\u001b[100C  \r\n  \u001b[3X\u001b[3C\u001b[38;2;136;136;136m┌──────┬──────────────────────────────────┬─────────────────────────────────────────────────────────────────┐\u001b[38;2;238;238;238m  \r\n\u001b[38;2;255;255;255m  \u001b[3X\u001b[3C\u001b[38;2;136;136;136m│\u001b[1X\u001b[1C\u001b[38;2;157;124;216;1mRank\u001b[1X\u001b[1C\u001b[38;2;136;136;136;22m│\u001b[1X\u001b[1C\u001b[38;2;157;124;216;1mProgram\u001b[26X\u001b[26C\u001b[38;2;136;136;136;22m│\u001b[1X\u001b[1C\u001b[38;2;157;124;216;1mWhy it is easy\u001b[50X\u001b[50C\u001b[38;2;136;136;136;22m│\u001b[38;2;238;238;238m  \r\n\u001b[38;2;255;255;255m     \u001b[38;2;136;136;136m├──────┼──────────────────────────────────┼─────────────────────────────────────────────────────────────────┤\u001b[38;2;255;255;255m  \r\n  \u001b[3X\u001b[3C\u001b[38;2;136;136;136m│ \u001b[38;2;238;238;238m1   \u001b[38;2;255;255;255m \u001b[38;2;136;136;136m│ \u001b[38;2;245;167;66;1mProgram 1 - \u001b[38;2;127;216;143;22mTransformController.\u001b[1X\u001b[1C\u001b[38;2;136;136;136m│ \u001b[38;2;238;238;238mOnly uses \u001b[38;2;127;216;143mTranslate\u001b[38;2;238;238;238m, \u001b[38;2;127;216;143mRotate \u001b[38;2;238;238;238mand \u001b[38;2;127;216;143mlocalScale\u001b[38;2;238;238;238m. No extra packages, \u001b[1X\u001b[1C\u001b[38;2;136;136;136m│\u001b[38;2;238;238;238m  \u001b[38;2;255;255;255m  \u001b[3X\u001b[3C\u001b[38;2;136;136;136m│      │ \u001b[38;2;127;216;143mcs\u001b[31X\u001b[31C\u001b[38;2;136;136;136m│ \u001b[38;2;238;238;238mno math, and the controls map directly to the code.\u001b[13X\u001b[13C\u001b[38;2;136;136;136m│\u001b[38;2;255;255;255m  \r\n     \u001b[38;2;136;136;136m├──────┼──────────────────────────────────┼─────────────────────────────────────────────────────────────────┤\u001b[38;2;238;238;238m  \r\n\u001b[38;2;255;255;255m  \u001b[3X\u001b[3C\u001b[38;2;136;136;136m│ \u001b[38;2;238;238;238m2   \u001b[38;2;255;255;255m \u001b[38;2;136;136;136m│ \u001b[38;2;245;167;66;1mProgram 4 - \u001b[38;2;127;216;143;22mRaycast2DTarget.cs\u001b[3X\u001b[3C\u001b[38;2;136;136;136m│ \u001b[38;2;238;238;238mShortest script. One main idea: \u001b[38;2;127;216;143mPhysics2D.Raycast(origin, \u001b[6X\u001b[6C\u001b[38;2;136;136;136m│\u001b[38;2;238;238;238m  \u001b[38;2;255;255;255m  \u001b[3X\u001b[3C\u001b[38;2;136;136;136m│      │                                  │ \u001b[38;2;127;216;143mdirection, distance)\u001b[38;2;238;238;238m. The rest is just checking the hit and     \u001b[38;2;136;136;136m│\u001b[38;2;238;238;238m  \r\n\u001b[38;2;255;255;255m  \u001b[3X\u001b[3C\u001b[38;2;136;136;136m│ \u001b[38;2;255;255;255m \u001b[38;2;238;238;238m    \u001b[38;2;136;136;136m│ \u001b[30X\u001b[30C\u001b[38;2;127;216;143m   \u001b[38;2;136;136;136m│ \u001b[38;2;238;238;238mchanging colour.\u001b[42X\u001b[42C\u001b[38;2;127;216;143m      \u001b[38;2;136;136;136m│\u001b[38;2;238;238;238m  \r\n\u001b[38;2;255;255;255m     \u001b[38;2;136;136;136m├──────┼──────────────────────────────────┼─────────────────────────────────────────────────────────────────┤\u001b[38;2;238;238;238m  \u001b[38;2;255;255;255m  \u001b[3X\u001b[3C\u001b[38;2;136;136;136m│ \u001b[38;2;238;238;238m3\u001b[38;2;136;136;136m    │ \u001b[38;2;245;167;66;1mProgram 2 - \u001b[38;2;127;216;143;22mVRMenuController.cs\u001b[38;2;136;136;136m  │ \u001b[38;2;238;238;238mCode is just three \u001b[38;2;127;216;143monClick \u001b[38;2;238;238;238mlisteners and two UI changes. The    \u001b[38;2;136;136;136m│\u001b[38;2;255;255;255m       \u001b[38;2;136;136;136m│      │                                  │ \u001b[38;2;238;238;238monly heavy part is the Canvas/VR setup, not the C#.\u001b[13X\u001b[13C\u001b[38;2;136;136;136m│\u001b[38;2;238;238;238m  \r\n\u001b[38;2;255;255;255m     \u001b[38;2;136;136;136m└──────┴──────────────────────────────────┴─────────────────────────────────────────────────────────────────┘\u001b[38;2;238;238;238m  \u001b[38;2;255;255;255m      \u001b[38;2;136;136;136m \u001b[38;2;255;255;255m \u001b[38;2;136;136;136m    \u001b[38;2;255;255;255m \u001b[38;2;136;136;136m \u001b[31X\u001b[31C  \u001b[38;2;255;255;255m \u001b[38;2;136;136;136m \u001b[61X\u001b[61C\u001b[38;2;238;238;238m   \u001b[38;2;255;255;255m        \u001b[38;2;238;238;238mHonourable mention: \u001b[38;2;245;167;66;1mProgram 3 - \u001b[38;2;127;216;143mFirstPersonController.cs\u001b[38;2;238;238;238;22m. It is still short, but the mouse-look math (       \u001b[38;2;128;128;128m  \r\n\u001b[38;2;255;255;255m  \u001b[3X\u001b[3C\u001b[38;2;127;216;143mxRotation\u001b[38;2;238;238;238m, \u001b[38;2;127;216;143mMathf.Clamp\u001b[38;2;238;238;238m, \u001b[38;2;127;216;143mQuaternion.Euler\u001b[38;2;238;238;238m) takes a little more thought than the three above.\u001b[18X\u001b[18C\u001b[38;2;255;255;255m  \r\n     \u001b[108X\u001b[108C   \r\n  \u001b[3X\u001b[3C\u001b[38;2;238;238;238mIf you are revising in order, do \u001b[38;2;245;167;66;1m1 -> 4 -> 2\u001b[38;2;238;238;238;22m, then \u001b[38;2;245;167;66;1m3 -> 6 -> 5\u001b[38;2;238;238;238;22m. The last two have the most setup: Program 6  \u001b[38;2;255;255;255m  \r\n     \u001b[38;2;238;238;238mneeds video/audio, and Program 5 needs AR Foundation and a phone.\u001b[44X\u001b[44C\u001b[38;2;255;255;255m  \r\n     \u001b[108X\u001b[108C   \r\n     \u001b[38;2;92;156;245mBuild \u001b[38;2;128;128;128m· DeepSeek V4.1 Flash Free · 22.6s · 63.5 tok/s\u001b[56X\u001b[56C\u001b[38;2;238;238;238m  \u001b[38;2;255;255;255m                                                                                                                      \u001b[38;2;92;156;245m┃\u001b[38;2;255;255;255;48;2;30;30;30m                                                                                                               \u001b[48;2;10;10;10m    \u001b[38;2;92;156;245m┃\u001b[38;2;255;255;255;48;2;30;30;30m                                                                                                               \u001b[48;2;10;10;10m    \u001b[38;2;92;156;245m┃\u001b[38;2;255;255;255;48;2;30;30;30m                                                                                                               \u001b[48;2;10;10;10m    \u001b[38;2;92;156;245m┃\u001b[38;2;255;255;255;48;2;30;30;30m  \u001b[38;2;92;156;245mBuild \u001b[38;2;128;128;128m· \u001b[38;2;238;238;238mDeepSeek V4.1 Flash Free \u001b[38;2;128;128;128mOp